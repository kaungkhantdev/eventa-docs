							"content": [
								{
									"type": "text",
									"text": "Message parked"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "eventa.worker.dlq"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "durable \u00b7 no TTL \u00b7 no consumer"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "nothing drains it on its own"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "shape:dlq_n",
			"typeName": "shape",
