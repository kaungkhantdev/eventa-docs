							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "1 \u00b7 Notice"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "error log: 'parking in the dead-letter queue'"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "messages_handled_total \u00b7 outcome=parked"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "DLQ depth (RabbitMQ exporter): >0 warn, >10 or rising 15 min page"
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "shape:dlq_i",
			"typeName": "shape",
