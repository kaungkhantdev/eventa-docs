						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "2 \u00b7 Inspect \u2014 non-destructive"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Management UI \u2192 Queues \u2192 eventa.worker.dlq \u2192 Get messages"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Ack Mode = Nack message requeue true"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "(Automatic ack or reject-requeue-false CONSUMES it)"
								}
							]
						}
					]
				}
			}
		},
